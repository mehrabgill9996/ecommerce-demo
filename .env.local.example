# Stripe test keys — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Signing secret for the /api/webhooks/stripe route. When testing locally
# with the Stripe CLI (`stripe listen --forward-to localhost:3000/api/webhooks/stripe`),
# use the "whsec_..." value the CLI prints. In production, use the signing
# secret from the webhook endpoint you create in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: override the origin used for Stripe success/cancel redirect
# URLs. Defaults to the request's Origin header (or localhost in dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...
# Where order notification emails are sent (your inbox).
ORDER_NOTIFICATION_EMAIL=you@example.com
# Optional: sender address. Defaults to Resend's shared test sender, which
# only delivers to the email address on your Resend account until you
# verify your own sending domain.
ORDER_NOTIFICATION_FROM_EMAIL=onboarding@resend.dev
